# Database configuration for integration tests
# Ensure you have a running PostgreSQL instance.
# Create a test database (e.g. 'konn3ct_test') and run `npx prisma migrate deploy` before running integration tests.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/konn3ct_test?schema=public"

# Mock Paystack for testing without hitting the network
PAYSTACK_SECRET_KEY="sk_test_mock"
PAYSTACK_MOCK_MODE="true"

# Mock Bot Token Secret
BOT_TOKEN_SECRET="test_bot_secret"
