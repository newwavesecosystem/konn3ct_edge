{
  "name": "conn3ct",
  "version": "1.0.0",
  "description": "conn3ct meeting platform",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:signaling": "node dist/server.js",
    "start:media": "node dist/media-server.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run test/unit/",
    "test:integration": "vitest run test/integration/",
    "test:backend": "vitest run test/",
    "test:e2e": "cd frontend && npx playwright test",
    "test:layout": "cd frontend && npx playwright test e2e/layout.spec.ts",
    "prisma:validate": "prisma validate",
    "quality:gate": "npm run typecheck && npm run prisma:validate && npm run test:unit && npm run test:integration",
    "quality:gate:ui": "npm run test:layout",
    "quality:gate:full": "npm run quality:gate && npm run quality:gate:ui",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/s3-request-presigner": "^3.1075.0",
    "@deepgram/sdk": "^5.4.0",
    "@google/genai": "^1.52.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@prisma/client": "^6.10.1",
    "@types/fluent-ffmpeg": "^2.1.28",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.1",
    "ejs": "^3.1.10",
    "expo-server-sdk": "^6.1.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^8.2.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "mediasoup": "^3.19.22",
    "nodemailer": "^7.0.3",
    "openai": "^6.38.0",
    "prom-client": "^15.1.3",
    "puppeteer": "^24.43.0",
    "puppeteer-core": "^24.43.0",
    "puppeteer-stream": "^3.0.22",
    "redis": "^5.12.1",
    "swagger-ui-express": "^5.0.1",
    "web-push": "^3.6.7",
    "winston": "^3.19.0",
    "ws": "^8.18.3",
    "yamljs": "^0.3.0",
    "zod": "^4.0.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "@types/yamljs": "^0.2.34",
    "@vitest/coverage-v8": "^4.1.9",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.29.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "mediasoup-client": "^3.22.0",
    "prisma": "^6.10.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10",
    "vitest-mock-extended": "^4.0.0"
  }
