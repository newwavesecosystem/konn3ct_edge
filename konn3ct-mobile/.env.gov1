# Gov Conference environment — copy to .env to activate
EXPO_PUBLIC_API_URL=https://govsupport.convergenceondemand.com/conferencing/api/app
EXPO_PUBLIC_BACKEND_DOMAIN=meetingapi.convergenceondemand.com
EXPO_PUBLIC_EDGE_FRONTEND_URL=https://meetingapp.konn3ct.net
EXPO_PUBLIC_APP_NAME=Gov Conference
EXPO_PUBLIC_APP_LOGO=gov1
EXPO_PUBLIC_SHOW_ADDONS_TAB=false
EXPO_PUBLIC_SHOW_AI=false
EXPO_PUBLIC_SHOW_PAYMENTS=false
