# Gov1 Meeting environment — copy to .env to activate
EXPO_PUBLIC_API_URL=https://govsupport.convergenceondemand.com/conferencing/api/app
EXPO_PUBLIC_BACKEND_DOMAIN=meetingapi.konn3ct.net
EXPO_PUBLIC_APP_NAME=1Gov Meeting
EXPO_PUBLIC_APP_LOGO=gov1
EXPO_PUBLIC_SHOW_ADDONS_TAB=false
EXPO_PUBLIC_SHOW_AI=false
EXPO_PUBLIC_SHOW_PAYMENTS=false
EXPO_PUBLIC_SHOW_PREMIUM_PROMO=false
EXPO_PUBLIC_SHOW_NOTIFICATIONS=false
EXPO_PUBLIC_SHOW_HELP_ICON=false
EXPO_PUBLIC_SKIP_EMAIL_VERIFY=true