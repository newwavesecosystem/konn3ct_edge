# Konn3ct environment — copy to .env to activate
EXPO_PUBLIC_API_URL=https://dev.konn3ct.ng/api/app
EXPO_PUBLIC_BACKEND_DOMAIN=konn3ctedge.konn3ct.net
EXPO_PUBLIC_EDGE_FRONTEND_URL=https://edge.konn3ct.net
EXPO_PUBLIC_APP_NAME=Konn3ct
EXPO_PUBLIC_APP_LOGO=konn3ct
EXPO_PUBLIC_SHOW_ADDONS_TAB=true
EXPO_PUBLIC_SHOW_AI=true
EXPO_PUBLIC_SHOW_PAYMENTS=true
EXPO_PUBLIC_SHOW_PREMIUM_PROMO=true
EXPO_PUBLIC_SHOW_NOTIFICATIONS=true
EXPO_PUBLIC_SHOW_HELP_ICON=true
EXPO_PUBLIC_SKIP_EMAIL_VERIFY=false
EXPO_PUBLIC_SHOW_SIGNUP=true
EXPO_PUBLIC_SHOW_FORGOT_PASSWORD=true
EXPO_PUBLIC_GOV_LOGIN=false