DATABASE_URL="file:./dev.db"
PORT=3000
JWT_SECRET="your-jwt-secret-here"

#AI Configuration
OPENAI_API_KEY="sk-..."
GEMINI_API_KEY="Ai"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Paystack
PAYSTACK_PUBLIC_KEY="pk_test_placeholder"
PAYSTACK_SECRET_KEY="sk_test_placeholder"
PAYSTACK_CALLBACK_URL="http://localhost:3000/dashboard/billing/verify"
PAYSTACK_CURRENCY="NGN"
PAYSTACK_TEST_MODE="true"
PAYSTACK_MOCK_MODE="true"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_placeholder_key"

# S3 / DigitalOcean Spaces / AWS
DO_SPACES_ENDPOINT="https://nyc3.digitaloceanspaces.com"
DO_SPACES_REGION="nyc3"
DO_SPACES_KEY="your_access_key"
DO_SPACES_SECRET="your_secret_key"
DO_SPACES_BUCKET="kslas"
SIGNED_RECORDING_URL_TTL_SECONDS=3600
S3_FORCE_PATH_STYLE="false"
TELEMETRY_S3_BUCKET_NAME="kslas"


#Mediasoup Configuration
WEBRTC_LISTEN_IP=0.0.0.0
WEBRTC_ANNOUNCED_IP=127.0.0.1
RTC_MIN_PORT=10000
RTC_MAX_PORT=50000
MAX_INCOMING_BITRATE=5000000
INITIAL_OUTGOING_BITRATE=5000000


#Media Configuration
MAX_DEGRADATION_CPU_LOAD="85"
MAX_ACTIVE_CAMERAS="15"
TURN_DOMAIN="turnedge.konn3ct.net"
TURN_SECRET="my-super-strong-conn3ct-secret-123"

NEXT_PUBLIC_FRONTEND_DOMAIN="localhost:3001"
NEXT_PUBLIC_NETWORK_WINDOW_SIZE=5
NEXT_PUBLIC_NETWORK_MONITOR_INTERVAL=2000

#Transcription Configuration
DEEPGRAM_API_KEY="rrrrrrr"

#Redis Configuration
REDIS_URL="redis://127.0.0.1:12109"

#Integration Configuration
EXTERNAL_API_KEY="change-me"
BOT_SECRET="bot-secret"


