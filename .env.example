DATABASE_URL="file:./dev.db"
PORT=3000
JWT_SECRET="your-jwt-secret-here"
PAYSTACK_SECRET_KEY="your-paystack-secret-key-here"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_placeholder_key"
OPENAI_API_KEY="sk-..."

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Paystack
PAYSTACK_PUBLIC_KEY="pk_test_placeholder"
PAYSTACK_SECRET_KEY="sk_test_placeholder"
PAYSTACK_CALLBACK_URL="http://localhost:3000/dashboard/billing/verify"
PAYSTACK_CURRENCY="NGN"
PAYSTACK_TEST_MODE="true"
PAYSTACK_MOCK_MODE="true"

# S3 / DigitalOcean Spaces / AWS
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your_access_key"
AWS_SECRET_ACCESS_KEY="your_secret_key"
AWS_S3_BUCKET="konn3ct-recordings"
AWS_S3_RECORDINGS_PREFIX="recordings/"
SIGNED_RECORDING_URL_TTL_SECONDS=3600
S3_ENDPOINT="" # Use for DO spaces or MinIO
S3_FORCE_PATH_STYLE="false"
